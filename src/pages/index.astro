---
import Layout from '../layouts/Layout.astro';
import CanadaMap from '../components/home/CanadaMap';
import {
  getAllLocations,
  getProvinces,
  getTopCities,
  generateSlug,
  displayName,
} from '../lib/locations';
import { CITY_COORDINATES } from '../lib/city-coordinates';
import { formatNumber, formatCurrency } from '../lib/utils';
import type { MapCity } from '../components/home/CanadaMap';

const TOP_15 = new Set([
  'Toronto',
  'Montréal',
  'Montreal',
  'Calgary',
  'Ottawa',
  'Edmonton',
  'Winnipeg',
  'Vancouver',
  'Mississauga',
  'Brampton',
  'Hamilton',
  'Surrey',
  'Québec',
  'Quebec City',
  'Halifax',
]);

const provinces = await getProvinces();
provinces.sort((a, b) => a.GEO_NAME.localeCompare(b.GEO_NAME));
const topCities = await getTopCities(12);
const mapSourceCities = await getTopCities(32);

const mapCities: MapCity[] = mapSourceCities
  .map((c) => {
    const name = displayName(c.GEO_NAME);
    if (!TOP_15.has(name)) return null;
    const coords = CITY_COORDINATES[name];
    if (!coords) return null;
    return {
      name,
      pop: c.POP_2021 ?? 0,
      age: c.POP_AVG_AGE ?? 0,
      income: c.HH_INCOME_MEDIAN_AFTER_TAX || null,
      slug: generateSlug(c.GEO_NAME),
      coords,
    } satisfies MapCity;
  })
  .filter((c): c is MapCity => c != null);

const all = await getAllLocations();
const canadaRow = all.find(
  (l) => l.GEO_LEVEL === 'Country' || l.GEO_NAME === 'Canada'
);

const kpis = [
  {
    label: 'Population',
    value: canadaRow?.POP_2021 ? formatNumber(canadaRow.POP_2021) : '36,991,981',
    hint: 'Canada, Census 2021',
  },
  {
    label: 'Growth',
    value:
      canadaRow?.POP_CHANGE_PCT != null
        ? `${Number(canadaRow.POP_CHANGE_PCT).toFixed(1)}%`
        : '5.2%',
    hint: '2016–2021 population change',
  },
  {
    label: 'Median income',
    value: canadaRow?.HH_INCOME_MEDIAN_AFTER_TAX
      ? formatCurrency(canadaRow.HH_INCOME_MEDIAN_AFTER_TAX)
      : '$84,000',
    hint: 'Household median (after tax)',
  },
];
---

<Layout
  title="Canadian Data Insights | Interactive Statistics Canada census insights"
  description="Interactive Statistics Canada census insights — population, growth, income, and demographics for Canadian communities."
  canonicalPath="/"
>
  <div class="border-b border-primary/10 bg-primary/5 px-4 py-2 text-center">
    <p class="text-xs text-on-surface-variant sm:text-sm">
      Location profiles, Interactive Atlas, and the <a href="/compare/" class="font-medium text-primary underline-offset-2 hover:underline">Comparison tool</a> are live.
    </p>
  </div>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mb-12 max-w-2xl">
      <h1 class="font-heading text-4xl font-bold text-primary sm:text-5xl">
        Canadian <span class="text-tertiary">Data Insights</span>
      </h1>
      <p class="mt-4 font-sans text-lg leading-relaxed text-on-surface-variant">
        Interactive Statistics Canada census insights — explore provinces, territories, and cities from the 2021 Census.
      </p>
      <div class="mt-8 flex flex-wrap gap-3 sm:gap-4">
        <a
          href="/compare/"
          class="inline-flex min-h-[44px] items-center rounded-md bg-primary px-5 py-2.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-primary/90"
        >
          Compare locations
        </a>
        <a
          href="#largest-cities"
          class="inline-flex min-h-[44px] items-center rounded-md border border-primary/30 bg-surface px-5 py-2.5 text-sm font-semibold text-primary no-underline transition-colors hover:bg-primary/5"
        >
          Explore cities
        </a>
        <a
          href="/sources/"
          class="inline-flex min-h-[44px] items-center rounded-md border border-primary/20 bg-surface px-5 py-2.5 text-sm font-semibold text-on-surface-variant no-underline transition-colors hover:bg-primary/5 hover:text-primary"
        >
          Sources
        </a>
        <a
          href="/about/"
          class="inline-flex min-h-[44px] items-center rounded-md border border-primary/20 bg-surface px-5 py-2.5 text-sm font-semibold text-on-surface-variant no-underline transition-colors hover:bg-primary/5 hover:text-primary"
        >
          About
        </a>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-3">
      {
        kpis.map((kpi) => (
          <article class="rounded-xl border border-border/50 bg-surface p-6 shadow-sm">
            <p class="font-sans text-xs font-medium uppercase tracking-widest text-on-surface-variant">
              {kpi.label}
            </p>
            <p class="mt-2 font-heading text-3xl font-bold text-primary">{kpi.value}</p>
            <p class="mt-1 text-xs text-on-surface-variant">{kpi.hint}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Interactive Atlas -->
  <section class="border-t border-border/30 bg-surface-soft py-12" aria-labelledby="atlas-heading">
    <div class="mx-auto max-w-screen-2xl px-4 sm:px-6">
      <div class="mb-6 max-w-2xl">
        <h2 id="atlas-heading" class="font-heading text-2xl font-bold text-primary sm:text-3xl">
          Interactive Atlas
        </h2>
        <p class="mt-2 font-sans text-sm text-on-surface-variant">
          Tap or hover city markers for census snapshots. Click through to full location profiles.
        </p>
      </div>
      <div class="relative h-[55vh] max-h-[520px] min-h-[420px] overflow-hidden rounded-xl border border-border/40 bg-surface-soft shadow-sm md:h-[720px] md:max-h-none md:min-h-[720px] lg:h-[800px] lg:min-h-[800px]">
        <CanadaMap client:load cities={mapCities} />
      </div>
    </div>
  </section>

  <section class="border-t border-border/30 py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="mb-2 font-heading text-2xl font-bold text-primary">Provinces &amp; territories</h2>
      <p class="mb-8 font-sans text-sm text-on-surface-variant">
        Census profiles for every province and territory.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          provinces.map((p) => (
            <a
              href={`/location/${generateSlug(p.GEO_NAME)}/`}
              class="rounded-lg border border-border/40 bg-surface px-4 py-3 font-medium text-primary no-underline shadow-sm transition-colors hover:border-primary/40 hover:bg-primary/5"
            >
              <span class="font-heading font-bold">{displayName(p.GEO_NAME)}</span>
              <span class="mt-1 block text-xs font-normal text-on-surface-variant">
                Pop. {formatNumber(p.POP_2021)}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section id="largest-cities" class="scroll-mt-20 border-t border-border/30 bg-surface-soft py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <h2 class="mb-2 font-heading text-2xl font-bold text-primary">Largest cities</h2>
      <p class="mb-8 font-sans text-sm text-on-surface-variant">
        Top census subdivisions by 2021 population.
      </p>
      <div class="grid gap-3 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4">
        {
          topCities.map((c) => (
            <a
              href={`/location/${generateSlug(c.GEO_NAME)}/`}
              class="rounded-lg border border-border/40 bg-surface px-4 py-3 font-medium text-primary no-underline shadow-sm transition-colors hover:border-primary/40 hover:bg-primary/5"
            >
              <span class="font-heading font-bold">{displayName(c.GEO_NAME)}</span>
              <span class="mt-1 block text-xs font-normal text-on-surface-variant">
                Pop. {formatNumber(c.POP_2021)}
                {c.PROVINCE ? ` · ${c.PROVINCE}` : ''}
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
