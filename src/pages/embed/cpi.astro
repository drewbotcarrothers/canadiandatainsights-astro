---
import Embed from '../../layouts/Embed.astro';
import TrendChart from '../../components/release/TrendChart.astro';
import { cpiChartTitle, cpiRelease } from '../../lib/release';
---

<Embed title={cpiChartTitle} canonicalPath="/data/cpi/">
  <TrendChart points={cpiRelease.trend} title={cpiChartTitle} mode="index" unit="index, 2002=100" />
  <p class="mt-3 font-sans text-sm leading-relaxed text-on-surface">
    Chart: <a href="https://canadiandatainsights.com/data/cpi/">Canadian Data Insights</a>. Source: Statistics Canada.
  </p>
</Embed>
