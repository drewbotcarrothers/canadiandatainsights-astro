---
import Layout from '../../layouts/Layout.astro';
import {
  asOfLine,
  cpiRelease,
  countMovement,
  cpiSummary,
  formatRate,
  housingRelease,
  housingSummary,
  jobsRelease,
  jobsSummary,
} from '../../lib/release';
import { dataHubJsonLd } from '../../lib/seo';
import { formatIndex, formatNumber, formatRefMonth, formatSignedPercentPoints } from '../../lib/utils';

const description =
  'Release-day Statistics Canada pages for the Consumer Price Index, the Labour Force Survey, and housing starts, with city tables, charts, and CSV downloads.';
const cards = [
  {
    href: '/data/cpi/',
    csv: '/data/cpi.csv',
    kicker: `Table ${cpiRelease.table.id}`,
    title: `Consumer Price Index, ${formatRefMonth(cpiRelease.referenceMonth)}`,
    asOf: asOfLine(cpiRelease.referenceMonth, cpiRelease.releaseDate),
    stat: `${formatIndex(cpiRelease.canada.index)} · ${formatSignedPercentPoints(cpiRelease.canada.yoyPct)} in 12 months`,
    summary: cpiSummary(),
  },
  {
    href: '/data/jobs/',
    csv: '/data/jobs.csv',
    kicker: `Tables ${jobsRelease.tables.map((table) => table.id).join(' and ')}`,
    title: `Labour Force Survey, ${formatRefMonth(jobsRelease.referenceMonth)}`,
    asOf: asOfLine(jobsRelease.referenceMonth, jobsRelease.releaseDate),
    stat: `${formatRate(jobsRelease.canada.unemploymentRate)}% unemployment · employment ${countMovement(jobsRelease.canada.employmentChangePersons, 'persons')}`,
    summary: jobsSummary(),
  },
  {
    href: '/data/housing-starts/',
    csv: '/data/housing-starts.csv',
    kicker: `Tables ${housingRelease.tables.map((table) => table.id).join(' and ')}`,
    title: `Housing starts, ${formatRefMonth(housingRelease.referenceMonth)}`,
    asOf: asOfLine(housingRelease.referenceMonth, housingRelease.releaseDate),
    stat: `${formatNumber(housingRelease.canada.saarUnits)} units, annual rate`,
    summary: housingSummary(),
  },
];
---

<Layout title="Release-day data" description={description} canonicalPath="/data/" jsonLd={dataHubJsonLd(description)}>
  <section class="bg-background py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
        Statistics Canada
      </p>
      <h1 class="mt-3 font-heading text-4xl font-bold text-primary sm:text-5xl">
        Release-day <span class="text-tertiary">data</span>
      </h1>
      <p class="mt-4 max-w-3xl font-sans text-lg leading-relaxed text-on-surface-variant">
        Three reference pages built from the latest published Statistics Canada tables: prices, jobs, and
        housing starts. Each page has a city table, a chart, a CSV download, and embed code.
      </p>
      <p class="mt-3 font-sans text-sm text-on-surface-variant">Prepared by Andrew.</p>
      <div class="mt-10 grid gap-6 lg:grid-cols-3">
        {
          cards.map((card) => (
            <article class="flex flex-col rounded-xl border border-border/40 bg-surface p-6 shadow-sm">
              <p class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">{card.kicker}</p>
              <h2 class="mt-2 font-heading text-2xl font-bold text-primary">
                <a href={card.href} class="no-underline hover:underline">{card.title}</a>
              </h2>
              <p class="mt-2 font-sans text-sm font-semibold text-on-surface">{card.asOf}</p>
              <p class="mt-4 font-heading text-xl font-bold text-tertiary">{card.stat}</p>
              <p class="mt-3 font-sans text-sm leading-relaxed text-on-surface-variant">{card.summary}</p>
              <p class="mt-4 flex flex-wrap gap-4 font-sans text-sm font-medium">
                <a href={card.href} class="text-primary underline-offset-2 hover:underline">Open page</a>
                <a href={card.csv} class="text-primary underline-offset-2 hover:underline">Download CSV</a>
              </p>
            </article>
          ))
        }
      </div>
    </div>
  </section>
</Layout>
