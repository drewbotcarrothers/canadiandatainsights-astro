---
import Layout from '../../layouts/Layout.astro';
import Attribution from '../../components/release/Attribution.astro';
import EmbedSnippet from '../../components/release/EmbedSnippet.astro';
import TrendChart from '../../components/release/TrendChart.astro';
import {
  asOfLine,
  cpiChartTitle,
  cpiRelease,
  cpiSummary,
  embedSnippet,
} from '../../lib/release';
import { releaseDatasetJsonLd } from '../../lib/seo';
import { formatIndex, formatRefMonth, formatSignedPercentPoints } from '../../lib/utils';

const file = cpiRelease;
const month = formatRefMonth(file.referenceMonth);
const summary = cpiSummary();
const title = `Consumer Price Index, ${month}`;
const snippet = embedSnippet('cpi', cpiChartTitle);
const jsonLd = releaseDatasetJsonLd({
  name: title,
  description: summary,
  path: '/data/cpi/',
  csvPath: '/data/cpi.csv',
  temporalCoverage: `${file.trend[0].month}/${file.referenceMonth}`,
  tables: [{ name: file.table.title, url: file.table.url }],
});
---

<Layout title={title} description={summary} canonicalPath="/data/cpi/" jsonLd={jsonLd}>
  <article class="bg-background py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
        <a href="/data/" class="no-underline hover:underline">Data</a>
        <span aria-hidden="true"> · </span>
        Statistics Canada · Table {file.table.id}
      </p>
      <h1 class="mt-3 font-heading text-4xl font-bold text-primary sm:text-5xl">
        Consumer Price Index, <span class="text-tertiary">{month}</span>
      </h1>
      <p class="mt-3 font-sans text-sm font-semibold text-on-surface">{asOfLine(file.referenceMonth, file.releaseDate)}</p>
      <p class="mt-4 max-w-3xl font-sans text-lg leading-relaxed text-on-surface-variant">{summary}</p>
      <p class="mt-3 font-sans text-sm text-on-surface-variant">Prepared by Andrew.</p>

      <dl class="mt-8 grid gap-4 sm:grid-cols-3">
        <div class="rounded-xl border border-border/40 bg-surface p-5">
          <dt class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">Canada, all-items</dt>
          <dd class="mt-1 font-heading text-3xl font-bold text-primary">{formatIndex(file.canada.index)}</dd>
          <dd class="mt-1 font-sans text-xs text-on-surface-variant">{file.table.uom}</dd>
        </div>
        <div class="rounded-xl border border-border/40 bg-surface p-5">
          <dt class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">12-month change</dt>
          <dd class="mt-1 font-heading text-3xl font-bold text-primary">{formatSignedPercentPoints(file.canada.yoyPct)}</dd>
          <dd class="mt-1 font-sans text-xs text-on-surface-variant">From {formatRefMonth(file.yearAgoMonth)}</dd>
        </div>
        <div class="rounded-xl border border-border/40 bg-surface p-5">
          <dt class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">1-month change</dt>
          <dd class="mt-1 font-heading text-3xl font-bold text-primary">{formatSignedPercentPoints(file.canada.momPct)}</dd>
          <dd class="mt-1 font-sans text-xs text-on-surface-variant">From {formatRefMonth(file.previousMonth)}</dd>
        </div>
      </dl>

      <div class="mt-10 rounded-xl border border-border/40 bg-surface p-5 sm:p-6">
        <TrendChart points={file.trend} title={cpiChartTitle} mode="index" unit="index, 2002=100" />
      </div>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a
          href="/data/cpi.csv"
          download="cpi.csv"
          class="inline-flex min-h-[44px] items-center rounded-md bg-tertiary px-5 py-2.5 text-sm font-semibold text-white no-underline hover:bg-tertiary/90"
        >
          Download CSV
        </a>
        <a href="/cost-of-living/" class="font-sans text-sm font-medium text-primary underline-offset-2 hover:underline">
          Cost of living, including grocery prices
        </a>
      </div>

      <h2 class="mt-12 font-heading text-2xl font-bold text-primary">Provinces and cities</h2>
      <p class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-on-surface-variant">
        Ranked by the 12-month percent change calculated from the published all-items index. City names are
        Statistics Canada’s price-index geographies, which are wider than a municipal boundary. Whitehorse,
        Yellowknife, and Iqaluit are the territorial series in this table.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border/40 bg-surface">
        <table class="min-w-full text-left font-sans text-sm">
          <caption class="sr-only">All-items Consumer Price Index by geography, {month}</caption>
          <thead class="border-b border-border/40 bg-surface-soft text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">Rank</th>
              <th scope="col" class="px-3 py-3 sm:px-4">Geography</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">12-month</th>
              <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">1-month</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Index</th>
              <th scope="col" class="hidden px-4 py-3 lg:table-cell">Kind</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/20 bg-primary/5">
              <td class="px-3 py-3 text-on-surface-variant sm:px-4">—</td>
              <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">Canada</th>
              <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatSignedPercentPoints(file.canada.yoyPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{formatSignedPercentPoints(file.canada.momPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(file.canada.index)}</td>
              <td class="hidden px-4 py-3 lg:table-cell">Country</td>
            </tr>
            {
              file.rows.map((row, index) => (
                <tr class="border-b border-border/20 last:border-0">
                  <td class="px-3 py-3 tabular-nums text-on-surface-variant sm:px-4">{index + 1}</td>
                  <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">
                    {row.geo}
                    {row.caution ? <span class="ml-1 font-sans text-xs font-medium text-on-surface-variant">(use with caution)</span> : null}
                  </th>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatSignedPercentPoints(row.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{formatSignedPercentPoints(row.momPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(row.index)}</td>
                  <td class="hidden px-4 py-3 capitalize lg:table-cell">{row.kind}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="mt-10">
        <EmbedSnippet snippet={snippet} />
      </div>
      <div class="mt-10">
        <Attribution tables={[file.table]} adapted={file.adapted} licence={file.licence} />
      </div>
    </div>
  </article>
</Layout>
