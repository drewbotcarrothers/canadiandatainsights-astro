---
import Layout from '../../layouts/Layout.astro';
import ChangeBars from '../../components/inflation/ChangeBars.astro';
import PageHeader from '../../components/inflation/PageHeader.astro';
import { asOfLine } from '../../lib/release';
import { inflationPageJsonLd } from '../../lib/seo';
import {
  componentsIn,
  extremes,
  formatPp,
  formatWeight,
  inflation,
  inflationCoverage,
  inflationCsv,
  inflationTables,
  joinNames,
  monthLabel,
  moved,
} from '../../lib/inflation';
import { formatIndex, formatSignedPercentPoints } from '../../lib/utils';

const month = monthLabel();
const majors = componentsIn('major');
const specials = componentsIn('special');
const ranked = [...majors].filter((row) => row.yoyPct != null).sort((a, b) => (b.yoyPct ?? 0) - (a.yoyPct ?? 0));
const { high, low } = extremes(majors, (row) => row.yoyPct);
const momRanked = [...majors].filter((row) => row.momPct != null);
const momExtreme = extremes(momRanked, (row) => row.momPct);
const contributionSum = majors.reduce((sum, row) => sum + (row.approxContributionPp ?? 0), 0);
const leader = high[0];
const description = leader?.yoyPct != null
  ? `In the 12 months to ${month}, ${joinNames(high.map((row) => row.name))} ${high.length > 1 ? 'were' : 'was'} the fastest major CPI component, ${moved(leader.yoyPct)}. The eight approximate contributions add to ${formatPp(contributionSum)}, beside an all-items change of ${formatSignedPercentPoints(inflation.headline.yoyPct)}.`
  : `Major CPI components in ${month}.`;
const jsonLd = inflationPageJsonLd({
  name: `Inflation components, ${month}`,
  description,
  path: '/inflation/components/',
  csvPath: inflationCsv.components,
  temporalCoverage: inflationCoverage(),
  tables: inflationTables(['18-10-0004-01', '18-10-0007-01']),
});
---

<Layout title={`Inflation components, ${month}`} description={description} canonicalPath="/inflation/components/" jsonLd={jsonLd}>
  <article class="bg-background py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <PageHeader
        kicker={`Table 18-10-0004-01 · basket ${inflation.weightYear}`}
        title="What is driving"
        accent="inflation"
        asOf={asOfLine(inflation.referenceMonth, inflation.releaseDate)}
      >
        <p slot="lede">{description} The eight major components partition the basket. Energy, gasoline, goods, and services cut across them, so their changes are not added to the eight.</p>
      </PageHeader>

      <div class="mt-10 rounded-xl border border-border/40 bg-surface p-5 sm:p-6">
        <ChangeBars
          title={`12-month change by major component, ${month}`}
          source={`Basket weights are the ${inflation.weightYear} link-month weights in table 18-10-0007-01. The approximate contribution is weight times the 12-month change, divided by 100. It is not a Statistics Canada contribution.`}
          rows={ranked.map((row) => ({
            label: row.name,
            value: row.yoyPct ?? 0,
            note: row.weight != null ? `${formatWeight(row.weight)} of the basket · ${formatPp(row.approxContributionPp)}` : undefined,
          }))}
        />
      </div>

      {
        momExtreme.high[0]?.momPct != null && (
          <p class="mt-6 max-w-3xl font-sans text-sm leading-relaxed text-on-surface-variant">
            The largest 1-month change among the eight was {moved(momExtreme.high[0].momPct)} for {joinNames(momExtreme.high.map((row) => row.name))}.
            {low[0]?.yoyPct != null ? ` Over 12 months, the slowest was ${joinNames(low.map((row) => row.name))}, ${moved(low[0].yoyPct)}.` : ''}
            {' '}These 1-month changes are not seasonally adjusted. A large move from {monthLabel(inflation.previousMonth)} can be the usual seasonal pattern.
          </p>
        )
      }

      <h2 class="mt-12 font-heading text-2xl font-bold text-primary">Eight major components</h2>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border/40 bg-surface">
        <table class="min-w-full text-left font-sans text-sm">
          <caption class="sr-only">Eight major CPI components, {month}</caption>
          <thead class="border-b border-border/40 bg-surface-soft text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">Component</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">12-month</th>
              <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">1-month</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Index</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">Weight</th>
              <th scope="col" class="hidden px-4 py-3 text-right lg:table-cell">Approx. contribution</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/20 bg-primary/5">
              <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">All-items</th>
              <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatSignedPercentPoints(inflation.headline.yoyPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{formatSignedPercentPoints(inflation.headline.momPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(inflation.headline.index)}</td>
              <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatWeight(100)}</td>
              <td class="hidden px-4 py-3 text-right lg:table-cell">—</td>
            </tr>
            {
              majors.map((row) => (
                <tr class="border-b border-border/20 last:border-0">
                  <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">{row.name}</th>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatSignedPercentPoints(row.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{formatSignedPercentPoints(row.momPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(row.index)}</td>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatWeight(row.weight)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums lg:table-cell">{formatPp(row.approxContributionPp)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-on-surface-variant">
        The eight approximate contributions add to {formatPp(contributionSum)}. The all-items 12-month change is {formatSignedPercentPoints(inflation.headline.yoyPct)}.
        They do not have to match. The weights are the {inflation.weightYear} link-month basket, and this product is not the contribution Statistics Canada publishes in The Daily.
        Food and shelter are broken out on their own pages.
      </p>

      <h2 class="mt-12 font-heading text-2xl font-bold text-primary">Aggregates that overlap the basket</h2>
      <p class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-on-surface-variant">
        These indexes are useful comparisons. They are not extra pieces to add to the eight major components. Goods were {formatWeight(specials.find((row) => row.id === 'goods')?.weight)} of the {inflation.weightYear} basket and services {formatWeight(specials.find((row) => row.id === 'services')?.weight)}.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border/40 bg-surface">
        <table class="min-w-full text-left font-sans text-sm">
          <caption class="sr-only">Special CPI aggregates, {month}</caption>
          <thead class="border-b border-border/40 bg-surface-soft text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">Aggregate</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">12-month</th>
              <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">1-month</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Index</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">Weight</th>
            </tr>
          </thead>
          <tbody>
            {
              specials.map((row) => (
                <tr class="border-b border-border/20 last:border-0">
                  <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">{row.name}</th>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatSignedPercentPoints(row.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{formatSignedPercentPoints(row.momPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(row.index)}</td>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{formatWeight(row.weight)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-8 font-sans text-sm">
        <a href={inflationCsv.components} class="font-medium text-primary underline-offset-2 hover:underline">Download the component CSV</a>
        <span aria-hidden="true"> · </span>
        <a href="/inflation/methodology/" class="font-medium text-primary underline-offset-2 hover:underline">How the contribution is calculated</a>
      </p>
    </div>
  </article>
</Layout>
