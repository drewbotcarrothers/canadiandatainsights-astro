---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/inflation/PageHeader.astro';
import { asOfLine } from '../../lib/release';
import { inflationPageJsonLd } from '../../lib/seo';
import {
  extremes,
  inflation,
  inflationCoverage,
  inflationCsv,
  inflationTables,
  joinNames,
  monthLabel,
} from '../../lib/inflation';
import { formatIndex, formatSignedPercentPoints } from '../../lib/utils';

const month = monthLabel();
const provinces = inflation.provinces;
const spread = extremes(provinces, (row) => row.allItems?.yoyPct);
const high = spread.high[0]?.allItems?.yoyPct;
const low = spread.low[0]?.allItems?.yoyPct;
const energyAbove = provinces.every(
  (row) => row.energy?.yoyPct != null && row.allItems?.yoyPct != null && row.energy.yoyPct > row.allItems.yoyPct
);
const foodBelow = provinces.every(
  (row) => row.food?.yoyPct != null && row.allItems?.yoyPct != null && row.food.yoyPct < row.allItems.yoyPct
);
const description =
  high != null && low != null
    ? `In ${month}, provincial all-items inflation ranged from ${formatSignedPercentPoints(low)} in ${joinNames(spread.low.map((row) => row.geo))} to ${formatSignedPercentPoints(high)} in ${joinNames(spread.high.map((row) => row.geo))}.`
    : `Provincial and city CPI inflation in ${month}.`;
const cities = [...inflation.cities].sort((a, b) => (b.allItems?.yoyPct ?? -999) - (a.allItems?.yoyPct ?? -999));
const jsonLd = inflationPageJsonLd({
  name: `Inflation by province and city, ${month}`,
  description,
  path: '/inflation/places/',
  csvPath: inflationCsv.places,
  temporalCoverage: inflationCoverage(),
  tables: inflationTables(['18-10-0004-01']),
});

function cell(value: number | null | undefined) {
  return formatSignedPercentPoints(value);
}
---

<Layout title={`Inflation by province and city, ${month}`} description={description} canonicalPath="/inflation/places/" jsonLd={jsonLd}>
  <article class="bg-background py-12 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <PageHeader
        kicker={`Table 18-10-0004-01 · ${month}`}
        title="Inflation by"
        accent="place"
        asOf={asOfLine(inflation.referenceMonth, inflation.releaseDate)}
      >
        <p slot="lede">
          {description}
          {energyAbove ? ' The energy index rose faster than all-items in every province.' : ''}
          {foodBelow ? ' The food index rose more slowly than all-items in every province.' : ''}
          {' '}City names are Statistics Canada price-index geographies, which are wider than a municipal boundary. The full all-items release table is on the <a href="/data/cpi/" class="font-medium text-primary underline-offset-2 hover:underline">CPI data page</a>.
        </p>
      </PageHeader>

      <h2 class="mt-12 font-heading text-2xl font-bold text-primary">Provinces</h2>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border/40 bg-surface">
        <table class="min-w-full text-left font-sans text-sm">
          <caption class="sr-only">CPI 12-month change by province, {month}</caption>
          <thead class="border-b border-border/40 bg-surface-soft text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">Province</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">All-items</th>
              <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">1-month</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">Food</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Shelter</th>
              <th scope="col" class="hidden px-4 py-3 text-right lg:table-cell">Transportation</th>
              <th scope="col" class="hidden px-4 py-3 text-right lg:table-cell">Energy</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-border/20 bg-primary/5">
              <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">Canada</th>
              <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(inflation.headline.yoyPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{cell(inflation.headline.momPct)}</td>
              <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(inflation.components.find((row) => row.id === 'food')?.yoyPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{cell(inflation.components.find((row) => row.id === 'shelter')?.yoyPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums lg:table-cell">{cell(inflation.components.find((row) => row.id === 'transportation')?.yoyPct)}</td>
              <td class="hidden px-4 py-3 text-right tabular-nums lg:table-cell">{cell(inflation.components.find((row) => row.id === 'energy')?.yoyPct)}</td>
            </tr>
            {
              provinces.map((row) => (
                <tr class="border-b border-border/20 last:border-0">
                  <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">{row.geo}</th>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(row.allItems?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{cell(row.allItems?.momPct)}</td>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(row.food?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{cell(row.shelter?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums lg:table-cell">{cell(row.transportation?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums lg:table-cell">{cell(row.energy?.yoyPct)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="mt-12 font-heading text-2xl font-bold text-primary">Territorial capitals</h2>
      <p class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-on-surface-variant">
        Yukon, the Northwest Territories, and Nunavut are not published as territorial all-items indexes in this table. Whitehorse, Yellowknife, and Iqaluit are. A blank cell is a series this table does not publish for that place.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border/40 bg-surface">
        <table class="min-w-full text-left font-sans text-sm">
          <caption class="sr-only">CPI for territorial capitals, {month}</caption>
          <thead class="border-b border-border/40 bg-surface-soft text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">Geography</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">All-items</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">Food</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Shelter</th>
              <th scope="col" class="hidden px-4 py-3 text-right lg:table-cell">Energy</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Index</th>
            </tr>
          </thead>
          <tbody>
            {
              inflation.territorial.map((row) => (
                <tr class="border-b border-border/20 last:border-0">
                  <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">{row.geo}</th>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(row.allItems?.yoyPct)}</td>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(row.food?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{cell(row.shelter?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums lg:table-cell">{cell(row.energy?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(row.allItems?.index)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2 class="mt-12 font-heading text-2xl font-bold text-primary">Cities</h2>
      <p class="mt-3 max-w-3xl font-sans text-sm leading-relaxed text-on-surface-variant">
        Ranked by the all-items 12-month change. Food, transportation, and energy are not published for these city series. Shelter is. Rent, as its own index, is not published at the city level in this table.
      </p>
      <div class="mt-6 overflow-x-auto rounded-xl border border-border/40 bg-surface">
        <table class="min-w-full text-left font-sans text-sm">
          <caption class="sr-only">City CPI, {month}</caption>
          <thead class="border-b border-border/40 bg-surface-soft text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            <tr>
              <th scope="col" class="px-3 py-3 sm:px-4">Rank</th>
              <th scope="col" class="px-3 py-3 sm:px-4">City</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">All-items</th>
              <th scope="col" class="hidden px-4 py-3 text-right sm:table-cell">1-month</th>
              <th scope="col" class="px-3 py-3 text-right sm:px-4">Shelter</th>
              <th scope="col" class="hidden px-4 py-3 text-right md:table-cell">Index</th>
            </tr>
          </thead>
          <tbody>
            {
              cities.map((row, index) => (
                <tr class="border-b border-border/20 last:border-0">
                  <td class="px-3 py-3 tabular-nums text-on-surface-variant sm:px-4">{index + 1}</td>
                  <th scope="row" class="px-3 py-3 font-heading font-bold text-primary sm:px-4">{row.geo}</th>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(row.allItems?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums sm:table-cell">{cell(row.allItems?.momPct)}</td>
                  <td class="px-3 py-3 text-right tabular-nums sm:px-4">{cell(row.shelter?.yoyPct)}</td>
                  <td class="hidden px-4 py-3 text-right tabular-nums md:table-cell">{formatIndex(row.allItems?.index)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="mt-8 font-sans text-sm">
        <a href={inflationCsv.places} class="font-medium text-primary underline-offset-2 hover:underline">Download the places CSV</a>
        <span aria-hidden="true"> · </span>
        <a href="/data/cpi/" class="font-medium text-primary underline-offset-2 hover:underline">CPI release page</a>
      </p>
    </div>
  </article>
</Layout>
