---
import Layout from '../../layouts/Layout.astro';
import BlogVisualization from '../../components/blog/BlogVisualization';
import { blogPosts } from '../../lib/blog-data';
import { blogPostingJsonLd } from '../../lib/seo';

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const jsonLd = blogPostingJsonLd({
  title: post.title,
  slug: post.slug,
  description: post.excerpt,
  datePublished: post.date,
  image: post.heroImage,
});
---

<Layout
  title={`${post.title} | Canadian Data Insights Blog`}
  description={post.excerpt}
  canonicalPath={`/blog/${post.slug}/`}
  ogType="article"
  ogImage={post.heroImage}
  jsonLd={jsonLd}
>
  <article class="bg-background py-12 sm:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <nav
        class="mb-10 flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant"
        aria-label="Breadcrumb"
      >
        <a href="/blog/" class="no-underline hover:text-primary">Blog</a>
        <span class="text-on-surface-variant/40">/</span>
        <span class="truncate text-primary">{post.title}</span>
      </nav>

      <header class="mb-10 sm:mb-12">
        <div class="mb-6 flex flex-wrap items-center gap-2 sm:gap-3">
          <span
            class="rounded-full border border-border/40 bg-surface-soft px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-on-surface-variant"
          >
            {post.category}
          </span>
          <span class="text-[10px] font-medium uppercase tracking-widest text-on-surface-variant">•</span>
          <span class="text-[10px] font-medium uppercase tracking-widest text-on-surface-variant">
            {post.date}
          </span>
          <span class="text-[10px] font-medium uppercase tracking-widest text-on-surface-variant">•</span>
          <span class="text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">
            {post.readTime}
          </span>
        </div>

        <h1
          class="mb-6 font-heading text-3xl font-black leading-tight tracking-tight text-primary sm:text-4xl lg:text-5xl"
        >
          {post.title}
        </h1>

        <p class="max-w-3xl font-sans text-lg font-medium leading-relaxed text-on-surface-variant sm:text-xl">
          {post.excerpt}
        </p>
      </header>

      {
        post.heroImage && (
          <div class="mb-12 overflow-hidden rounded-2xl border border-border/30 shadow-sm sm:mb-16">
            <img
              src={post.heroImage}
              alt={post.title}
              class="aspect-video w-full object-cover"
              width="1200"
              height="675"
              loading="eager"
            />
          </div>
        )
      }

      <div class="blog-prose font-sans text-base leading-relaxed text-on-surface-variant sm:text-lg" set:html={post.content} />

      {
        post.chartType && post.chartData && (
          <BlogVisualization
            client:visible
            type={post.chartType}
            data={post.chartData}
            title={post.chartTitle}
          />
        )
      }

      <div class="mt-12 border-t border-border/40 pt-8 sm:mt-16 sm:pt-10">
        <p class="mb-8 font-sans text-sm text-on-surface-variant">
          <a href="/sources/" class="font-medium text-primary underline-offset-2 hover:underline">Data source</a>
          {' '}→ Census methodology &amp; attribution
        </p>
        <a
          href="/blog/"
          class="inline-flex items-center gap-2 text-sm font-bold text-primary no-underline hover:underline"
        >
          <svg class="h-4 w-4 rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
          Back to All Insights
        </a>
      </div>
    </div>
  </article>
</Layout>

<style is:global>
  .blog-prose p {
    margin-bottom: 1.25em;
  }
  .blog-prose h2 {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--color-primary);
    font-size: 1.5rem;
    margin-top: 2em;
    margin-bottom: 0.75em;
    letter-spacing: -0.025em;
  }
  .blog-prose strong {
    color: var(--color-on-surface);
    font-weight: 600;
  }
  .blog-prose blockquote {
    border-left: 4px solid color-mix(in srgb, var(--color-primary) 25%, transparent);
    background: color-mix(in srgb, var(--color-surface-soft) 80%, transparent);
    padding: 1.5rem 2rem;
    border-radius: 0.75rem;
    font-style: italic;
    font-weight: 500;
    margin: 2em 0;
  }
  .blog-prose a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: none;
  }
  .blog-prose a:hover {
    text-decoration: underline;
  }
</style>
