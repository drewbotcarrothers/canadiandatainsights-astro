---
import SectionNav from './SectionNav.astro';

interface Props {
  kicker: string;
  title: string;
  accent: string;
  asOf?: string;
}

const { kicker, title, accent, asOf } = Astro.props;
---

<header>
  <p class="font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant">{kicker}</p>
  <h1 class="mt-3 font-heading text-4xl font-bold text-primary sm:text-5xl">
    {title} <span class="text-tertiary">{accent}</span>
  </h1>
  {asOf ? <p class="mt-3 font-sans text-sm font-semibold text-on-surface">{asOf}</p> : null}
  <div class="mt-4 max-w-3xl font-sans text-lg leading-relaxed text-on-surface-variant">
    <slot name="lede" />
  </div>
  <p class="mt-3 font-sans text-sm text-on-surface-variant">Prepared by Andrew.</p>
  <div class="mt-6">
    <SectionNav />
  </div>
</header>
