---
const pathname = Astro.url.pathname;

const links = [
  { href: '/', label: 'Dashboard' },
  { href: '/compare/', label: 'Comparisons' },
  { href: '/blog/', label: 'Blog' },
  { href: '/sources/', label: 'Sources' },
  { href: '/about/', label: 'About' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-border/40 bg-surface/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-baseline gap-1 no-underline">
      <span class="font-heading text-lg font-bold tracking-tight text-primary sm:text-xl">
        Canadian
      </span>
      <span class="font-heading text-lg font-bold tracking-tight text-on-surface sm:text-xl">
        Data
      </span>
      <span class="font-heading text-lg font-bold tracking-tight text-tertiary sm:text-xl">
        Insights
      </span>
    </a>

    <nav class="hidden items-center gap-1 sm:flex" aria-label="Primary">
      {links.map((link) => (
        <a
          href={link.href}
          class:list={[
            'rounded-md px-3 py-2 text-sm font-medium no-underline transition-colors',
            isActive(link.href)
              ? 'bg-primary/10 text-primary'
              : 'text-on-surface-variant hover:bg-surface-soft hover:text-primary',
          ]}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <details class="relative sm:hidden" id="mobile-nav">
      <summary
        class="flex min-h-[44px] min-w-[44px] cursor-pointer list-none items-center justify-center rounded-md border border-border px-3 py-2 text-sm font-medium text-on-surface"
        aria-label="Open navigation menu"
        aria-controls="mobile-nav-panel"
      >
        Menu
      </summary>
      <div
        id="mobile-nav-panel"
        class="absolute right-0 z-50 mt-2 w-56 rounded-lg border border-border bg-surface p-2 shadow-lg"
        role="navigation"
        aria-label="Mobile"
      >
        {links.map((link) => (
          <a
            href={link.href}
            class:list={[
              'flex min-h-[44px] items-center rounded-md px-3 py-2 text-base no-underline',
              isActive(link.href)
                ? 'bg-primary/10 text-primary'
                : 'text-on-surface-variant hover:bg-surface-soft',
            ]}
            data-mobile-nav-link
          >
            {link.label}
          </a>
        ))}
        <button
          type="button"
          class="mt-1 flex min-h-[44px] w-full items-center rounded-md px-3 py-2 text-left text-sm text-on-surface-variant hover:bg-surface-soft"
          data-mobile-nav-close
        >
          Close menu
        </button>
      </div>
    </details>
  </div>
</header>

<script is:inline>
  (function () {
    var root = document.getElementById('mobile-nav');
    if (!root) return;
    root.querySelectorAll('[data-mobile-nav-link]').forEach(function (el) {
      el.addEventListener('click', function () {
        root.removeAttribute('open');
      });
    });
    var closeBtn = root.querySelector('[data-mobile-nav-close]');
    if (closeBtn) {
      closeBtn.addEventListener('click', function () {
        root.removeAttribute('open');
      });
    }
  })();
</script>
