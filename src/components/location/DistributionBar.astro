---
import { formatNumber } from '../../lib/utils';

interface Props {
  label: string;
  value: number;
  max: number;
  total?: number;
  colorClass?: string;
  /** Replaces the default fixed label width. Long census labels need more room. */
  labelClass?: string;
}

const {
  label,
  value,
  max,
  total,
  colorClass = 'bg-primary',
  labelClass = 'sm:w-24 sm:text-right',
} = Astro.props;
const barPct = max > 0 ? (value / max) * 100 : 0;
const totalPct = total && total > 0 ? (value / total) * 100 : null;
const barWidth = value > 0 ? Math.max(barPct, 1) : 0;
---

<div class="flex flex-wrap items-center gap-x-3 gap-y-1 py-1.5 sm:flex-nowrap">
  <span class:list={['w-full shrink-0 font-sans text-sm leading-snug text-on-surface-variant', labelClass]}>{label}</span>
  <div class="h-5 min-w-[4rem] flex-grow overflow-hidden rounded-sm bg-surface-soft">
    <div class={`h-full rounded-sm ${colorClass}`} style={`width: ${barWidth}%`}></div>
  </div>
  <div class="ml-auto flex w-auto shrink-0 items-center justify-end gap-2 sm:w-36">
    <span class="text-right font-sans text-sm font-bold text-primary">{formatNumber(value)}</span>
    {
      totalPct !== null && (
        <span class="w-14 text-right font-sans text-xs text-on-surface-variant opacity-60">
          ({totalPct.toFixed(1)}%)
        </span>
      )
    }
  </div>
</div>
