---
import type { LocationSnapshot } from '../../data/location-snapshots';

interface Props {
  name: string;
  snapshot: LocationSnapshot;
}

const { name, snapshot } = Astro.props;
const people = snapshot.famousPeople?.filter((p) => p.name && p.note) ?? [];
---

<section class="bg-background py-10 sm:py-12 md:py-14" aria-labelledby="community-snapshot">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2
      id="community-snapshot"
      class="mb-4 font-sans text-[10px] font-bold uppercase tracking-widest text-on-surface-variant"
    >
      Community snapshot
    </h2>

    <div class="rounded-xl border border-border/30 bg-surface p-6 shadow-sm sm:p-8">
      <div class="max-w-3xl">
        <h3 class="mb-3 font-heading text-lg font-bold text-primary">About {name}</h3>
        <p class="font-sans text-base leading-relaxed text-on-surface-variant">
          {snapshot.about}
        </p>
      </div>

      <div class="mt-8 grid grid-cols-1 gap-8 border-t border-border/30 pt-8 md:grid-cols-2">
        <div>
          <h3 class="mb-4 font-heading text-lg font-bold text-primary">Known for</h3>
          <ul class="space-y-2.5">
            {
              snapshot.knownFor.map((item) => (
                <li class="flex gap-3 font-sans text-base text-on-surface-variant">
                  <span
                    class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-tertiary"
                    aria-hidden="true"
                  />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <h3 class="mb-4 font-heading text-lg font-bold text-primary">See &amp; do</h3>
          <ul class="space-y-4">
            {
              snapshot.seeAndDo.map((place) => (
                <li>
                  <p class="font-heading text-base font-bold text-primary">{place.name}</p>
                  <p class="mt-0.5 font-sans text-sm leading-relaxed text-on-surface-variant">
                    {place.why}
                  </p>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      {
        people.length > 0 && (
          <div class="mt-8 border-t border-border/30 pt-8">
            <h3 class="mb-4 font-heading text-lg font-bold text-primary">People</h3>
            <ul class="space-y-3">
              {people.map((person) => (
                <li>
                  <p class="font-heading text-base font-bold text-primary">{person.name}</p>
                  <p class="mt-0.5 font-sans text-sm leading-relaxed text-on-surface-variant">
                    {person.note}
                  </p>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <p class="mt-8 border-t border-border/30 pt-6 font-sans text-sm text-on-surface-variant">
        <a href="/sources/" class="font-medium text-primary underline-offset-2 hover:underline"
          >Data source</a
        >
        {' '}→ Census methodology &amp; attribution
      </p>
    </div>
  </div>
</section>
